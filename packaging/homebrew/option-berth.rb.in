class OptionBerth < Formula
  desc "Service facts and lifecycle for local Git worktrees"
  homepage "https://github.com/SheathedSharp/option-berth"
  license "MIT"

  on_macos do
    on_arm do
      url "{{BASE}}/{{TAG}}/option-berth-{{TAG}}-darwin-arm64.tar.gz"
      sha256 "{{DARWIN_ARM64}}"
    end
    on_intel do
      url "{{BASE}}/{{TAG}}/option-berth-{{TAG}}-darwin-amd64.tar.gz"
      sha256 "{{DARWIN_AMD64}}"
    end
  end

  on_linux do
    on_arm do
      url "{{BASE}}/{{TAG}}/option-berth-{{TAG}}-linux-arm64.tar.gz"
      sha256 "{{LINUX_ARM64}}"
    end
    on_intel do
      url "{{BASE}}/{{TAG}}/option-berth-{{TAG}}-linux-amd64.tar.gz"
      sha256 "{{LINUX_AMD64}}"
    end
  end

  def install
    bin.install "oberth", "jev-attention"
    pkgshare.install "LICENSE", "build-manifest.json", "licenses"
  end

  test do
    assert_match "option-berth", shell_output("#{bin}/oberth version")
  end
end
